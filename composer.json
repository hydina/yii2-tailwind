{
    "name": "hydina/yii2-tailwind",
    "description": "Yii2 Tailwind Installer",
    "type": "yii2-extension",
    "keywords": ["yii2", "tailwindcss", "ui", "hydina", "frontend"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Defina UI",
			"email": "info@defina.ee",
            "homepage": "https://hydina.netlify.app",
			"role": "Core Defina UI development"
        }
    ],
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.0"
    },
    "autoload": {
        "psr-4": {
            "Hydina\\ui\\": "src/"
        }
    },
    "extra": {
        "yii": {
            "bootstrap": "Hydina\\ui\\Bootstrap"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('tailwind.config.js') || copy('vendor/hydina/yii2-tailwind/resources/tailwind.config.js', 'tailwind.config.js');\""
        ]
    }
}
